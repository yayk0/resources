proxy-groups:
  - name: 🚀 默认代理
    type: select
    include-all: true
    proxies:
      - DIRECT
  - name: 🏠 回家代理
    type: select
    include-all: true
    filter: "(?i)nas"
    proxies:
      - DIRECT
  - name: 🌐 国际流媒体
    type: select
    include-all: true
    proxies:
      - 🚀 默认代理
      - DIRECT
  - name: 🤖 海外 AI
    type: select
    include-all: true
    proxies:
      - 🚀 默认代理
      - DIRECT
  - name: 💰 数字资产
    type: select
    include-all: true
    proxies:
      - 🚀 默认代理
      - DIRECT
  - name: 🍎 Apple Proxy
    type: select
    include-all: true
    proxies:
      - 🚀 默认代理
      - DIRECT
  - name: ♾️ Meta 服务
    type: select
    include-all: true
    proxies:
      - 🚀 默认代理
      - DIRECT
  - name: 🐦 X 与 PayPal
    type: select
    include-all: true
    proxies:
      - 🚀 默认代理
      - DIRECT
  - name: ✈️ Telegram
    type: select
    include-all: true
    proxies:
      - 🚀 默认代理
      - DIRECT
  - name: Ⓜ️ Microsoft 服务
    type: select
    include-all: true
    proxies:
      - 🚀 默认代理
      - DIRECT
  - name: 🎮 游戏平台
    type: select
    include-all: true
    proxies:
      - 🚀 默认代理
      - DIRECT
  - name: 🚀 常规代理
    type: select
    include-all: true
    proxies:
      - 🚀 默认代理
      - DIRECT
  - name: 🐟 漏网之鱼
    type: select
    include-all: true
    proxies:
      - 🚀 默认代理
      - DIRECT

