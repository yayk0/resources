geoip-url = https://raw.githubusercontent.com/Loyalsoldier/geoip/release/Country.mmdb
ip-mode = v4-only

ipv6 = false
hijack-dns = *:53

doh-server = https://dns.alidns.com/dns-query,https://doh.pub/dns-query

dns-server = system,223.5.5.5,119.29.29.29
allow-wifi-access = true
wifi-access-http-port = 7222
wifi-access-socks5-port = 7221
proxy-test-url = http://1.1.1.1/generate_204
internet-test-url = http://www.aliyun.com
test-timeout = 5
interface-mode = auto
real-ip = msftconnecttest.com,msftncsi.com,apple.com,icloud.com,ess.apple.com,push.apple.com
resource-parser = https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-parser.loon.min.js

[Proxy]

[Remote Proxy]
substore = https://substore.59999.xyz/nfreoa792c8x2njkz8it/api/file/yay,parser-enabled = true,udp=true,block-quic=true,fast-open=default,vmess-aead=true,skip-cert-verify=true,enabled=true,flexible-sni=false

[Proxy Chain]

[Remote Filter]
NoNAS = NameRegex, FilterKey = "(?i)^(?!.*nas).*$"
NAS = NameRegex, FilterKey = "(?i)nas"

[Proxy Group]
🚀 常规代理 = select,DIRECT,NoNAS
🏡 NAS节点 = select,NAS
🏡 回家策略 = ssid,default=🏡 NAS节点,cellular=🏡 NAS节点,"1301"=DIRECT
🌐 国际流媒体 = select,🚀 常规代理,DIRECT,NoNAS
🤖 海外 AI = select,🚀 常规代理,DIRECT,NoNAS
💰 数字资产 = select,🚀 常规代理,DIRECT,NoNAS
♾️ Meta 服务 = select,🚀 常规代理,DIRECT,NoNAS
𝕏 X 平台 = select,🚀 常规代理,DIRECT,NoNAS
✈️ Telegram = select,🚀 常规代理,DIRECT,NoNAS
Ⓜ️ 微软服务 = select,🚀 常规代理,DIRECT,NoNAS
🎮 游戏平台 = select,🚀 常规代理,DIRECT,NoNAS
🐟 漏网之鱼 = select,🚀 常规代理,DIRECT,NoNAS

[Rule]
IP-CIDR,192.168.5.0/24,🏡 回家策略,no-resolve
GEOIP,CN,DIRECT
FINAL,🐟 漏网之鱼

